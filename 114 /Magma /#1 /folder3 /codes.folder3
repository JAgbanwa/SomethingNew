// Corrected single-B search with exact residue filters in common.m.
// Run from the parent #1 directory.
load "common.m";

// The former B=-30/11 can NEVER give integer m,u.
// Choose an integer B congruent to 1 modulo 6.
B := 7;
// Example large setting: B := 10^30+3;
CoefficientBound := 6;
AllowIntegerY := false;

found := SearchB(B,CoefficientBound,AllowIntegerY);
printf "Finished selected B: %o verified triples.\n",#found;
print "An empty result is not a proof of global nonexistence.";
