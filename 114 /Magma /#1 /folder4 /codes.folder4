// Corrected rank discovery on admissible integer B values.
// Run from the parent #1 directory.
load "common.m";

BMin := -300;
BMax := 300;
CoefficientBound := 2;
SearchDetectedCurves := true;
AllowIntegerY := false;

found := {};
failed := [];
for B in [BMin..BMax] do
    if B mod 6 ne 1 then
        continue;
    end if;
    try
        E := CurveForB(B);
        r := Rank(E);
        printf "B=%o: reported rank=%o\n",B,r;
        if r ge 2 then
            G := Generators(E);
            printf "Returned generators: %o\n",G;
            if SearchDetectedCurves then
                hits := SearchGeneratorBox(B,E,G,CoefficientBound,AllowIntegerY);
                found := found join hits;
            end if;
        end if;
    catch err
        Append(~failed,B);
        printf "FAILED B=%o: %o\n",B,err;
    end try;
end for;
printf "Completed rank scan: %o verified triples; %o failed slices.\n",
       #found,#failed;
printf "Failed B values: %o\n",failed;
print "Rank data alone do not establish a solution with integer m,u.";
