// Corrected sweep over admissible integer B. See ../README.md.
// Run from the parent #1 directory.
load "common.m";

BMin := -29;
BMax := 31;
CoefficientBound := 2;
AllowIntegerY := false;

found := {};
failed := [];
for B in [BMin..BMax] do
    if B mod 6 ne 1 then
        continue;
    end if;
    try
        hits := SearchB(B,CoefficientBound,AllowIntegerY);
        found := found join hits;
    catch err
        Append(~failed,B);
        printf "FAILED B=%o: %o\n",B,err;
    end try;
end for;
printf "Completed finite sweep: %o verified triples; %o failed slices.\n",
       #found,#failed;
printf "Failed B values: %o\n",failed;
print "An empty result is not a proof of global nonexistence.";
