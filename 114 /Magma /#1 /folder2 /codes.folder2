// Corrected search on a chosen list of admissible integer B values.
// Run from the parent #1 directory.
load "common.m";

BValues := [1,7,13,19,25,31,37,43,49,55,
            -5,-11,-17,-23,-29,-35,-41,-47,-53];
CoefficientBound := 3;
AllowIntegerY := false;

found := {};
failed := [];
for B in BValues do
    assert B mod 6 eq 1;
    try
        hits := SearchB(B,CoefficientBound,AllowIntegerY);
        found := found join hits;
    catch err
        Append(~failed,B);
        printf "FAILED B=%o: %o\n",B,err;
    end try;
end for;
printf "Completed finite list: %o verified triples; %o failed slices.\n",
       #found,#failed;
printf "Failed B values: %o\n",failed;
print "An empty result is not a proof of global nonexistence.";
