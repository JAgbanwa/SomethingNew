// Phase 2: u-parametrization
printf "\n=== Phase 2: u-Param Search (|u|≤100, |n|≤50000) ===\n";
total_u := 0;
for u_val in [-100..100] do
    if not is_valid_u(u_val) then continue; end if;
    res := u_param_search(u_val, 50000);
    if #res gt 0 then
        for s in res do
            printf "  d=%o/%o n=%o x=%o k=%o u=%o [x%%12=%o x%%7=%o]\n",
                   s[1], s[2], s[3], s[4], s[5], s[6], s[4] mod 12, s[4] mod 7;
        end for;
        total_u +:= #res;
    end if;
end for;
printf "  Total: %o\n", total_u;

// Phase 3: Mordell curves
printf "\n=== Phase 3: Mordell Curves ===\n";

// u=-1: C = 12579840 (KEY CURVE — only valid u with integer C)
printf "[Key] ";
mordell_curve_search(-1, 12579840, 5);

// u=1: C = -12635136 (reference — rank 1, height 22.2 known)
printf "\n[Ref] ";
mordell_curve_search(1, -12635136, 3);

// Phase 4: E_n curves with rank jumps
printf "\n=== Phase 4: E_n Rank Jumps ===\n";
for n_val in [3, -6, -9] do
    elliptic_curve_search(n_val, 20);
end for;

