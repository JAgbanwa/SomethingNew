# SageMath code for finding rational d in
# 36n^3 + 4d x^2 - 4d^2 x^3 = 19
# via 36n^3 - 19 = a*b, x = ((b-a)/2)^2, d = 4b/(b-a)^3
#
# Run in chunks. Each chunk covers a digit range for n.
# Usage: set DIGIT_LOW and DIGIT_HIGH, and CHUNK_SECONDS.

import time, json, os
from sage.all import factor, Integer, QQ, gcd

# ---------- configuration ----------
DIGIT_LOW      = 10      # starting digit count for n
DIGIT_HIGH     = 14      # ending digit count (exclusive)
CHUNK_SECONDS  = 5400    # 1.5 hours per task
OUTFILE        = "rational_d_solutions.jsonl"
STATE_FILE     = "search_state.json"

# ---------- helpers ----------
def load_state():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            return json.load(f)
    return {"digit": DIGIT_LOW, "n_start": 10**(DIGIT_LOW-1)}

def save_state(st):
    with open(STATE_FILE, "w") as f:
        json.dump(st, f)

def append_solution(rec):
    with open(OUTFILE, "a") as f:
        f.write(json.dumps(rec) + "\n")

def try_n(n, seen):
    """Return list of new (d, n, x) for this n."""
    m = 36*n**3 - 19
    if m == 0:
        return []
    # factor m
    try:
        fac = factor(m)
    except Exception:
        return []
    # generate all divisors
    divs = [1]
    for p, e in fac:
        divs = [d * p**k for d in divs for k in range(e+1)]
    out = []
    for a in divs:
        b = m // a
        if (a & 1) == 0 or (b & 1) == 0:
            continue  # need both odd
        diff = b - a
        if diff == 0:
            continue
        x = (diff // 2)**2
        if x == 0:
            continue
        # d = 4b / diff^3
        num = 4*b
        den = diff**3
        g = gcd(abs(num), abs(den))
        num //= g; den //= g
        if den < 0:
            num, den = -num, -den
        d = QQ(num) / QQ(den)
        key = (str(d), int(n), int(x))
        if key in seen:
            continue
        seen.add(key)
        out.append({"d": str(d), "n": int(n), "x": int(x),
                    "digits_n": len(str(abs(n))),
                    "digits_x": len(str(abs(x)))})
    return out

# ---------- main ----------
def main():
    st = load_state()
    seen = set()
    if os.path.exists(OUTFILE):
        with open(OUTFILE) as f:
            for line in f:
                r = json.loads(line)
                seen.add((r["d"], r["n"], r["x"]))

    t0 = time.time()
    n = st["n_start"]
    digit = st["digit"]

    while digit < DIGIT_HIGH:
        hi = 10**digit
        while n < hi:
            if time.time() - t0 > CHUNK_SECONDS:
                st["digit"] = digit
                st["n_start"] = n
                save_state(st)
                print(f"[pause] digit={digit} n={n} elapsed={time.time()-t0:.0f}s")
                return
            for rec in try_n(n, seen):
                append_solution(rec)
                print("FOUND", rec)
            n += 1
        digit += 1
        n = 10**(digit-1)
        st["digit"] = digit
        st["n_start"] = n
        save_state(st)
        print(f"[digit] now searching {digit}-digit n")

    print("done")

if __name__ == "__main__":
    main()
