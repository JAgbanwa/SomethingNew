@dataclass(frozen=True)
class LabSettings:
    preset: str = "demo"
    n: int = 2
    slices: int = 12
    x_min: int = -100
    x_max: int = 100
    engine: str = "scan"
    target: str = "rational"
    axis: str = "ratio"
    tile_width: int = 64
    max_nodes: int = 200000
