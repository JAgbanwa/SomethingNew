            fig.canvas.mpl_connect("pick_event", self.on_pick)
            fig.canvas.mpl_connect("key_press_event", self.on_key)
        self.draw()

    def shift(self, amount):
        if self.overview:
            count = len(self.sample_values)
            self.sample_cursor = (self.sample_cursor + amount) % max(1, count - 1)
            self.draw()
            print("\nDisplayed 2D samples: " + ", ".join(map(str, self.selected_slices)) +
                  ". The full sampled 3D stack is unchanged.", flush=True)
            return
        proposed = replace(self.settings, n=self.settings.n + amount)
        print(f"\nSearching n={proposed.n}..{proposed.n+proposed.slices-1} ...", flush=True)
        try:
            result = run_search(proposed)
        except (ValueError, WorkLimitError, OverflowError) as exc:
            message = "The next window was not completed; the displayed result is unchanged.\n" + str(exc)
            print(message, flush=True)
            self.show_detail(message)
            return
        self.settings, self.result = proposed, result
        print_run_summary(result, proposed)
        self.draw()

    def on_key(self, event):
        if event.key in ("left", "right"):
            self.shift(-1 if event.key == "left" else 1)

    def view_order(self):
        return ("tiles", "residual", "points") if self.settings.engine == "lattice" else ("points", "residual")

    def cycle_view(self, event=None):
        order = self.view_order()
        self.mode = order[(order.index(self.mode) + 1) % len(order)]
        self.draw()

    def show_detail(self, message):
        lines = []
        for line in message.splitlines():
            lines.extend(textwrap.wrap(line, width=132, break_long_words=True, break_on_hyphens=False) or [""])
        if len(lines) > 7:
            lines = lines[:6] + ["Full exact values are printed in Terminal when you click."]
        for text in self.details:
            text.set_text("\n".join(lines))
        for fig in (self.fig2, self.fig3):
            fig.canvas.draw_idle()

    def on_pick(self, event):
        data = self.pick_data.get(event.artist)
        if data is None:
            return
        kind, items = data
        if kind == "tile":
            tile = items
            message = (
                f"CERTIFIED TANGENT TILE: n={tile['n']}, x in [{tile['a']}, {tile['b']}]\n"
                f"t0={tile['t0']}; alpha={tile['alpha']}; half-width w={tile['w']}\n"
                f"Reduced integer basis: {tile['basis']}; offset={tile.get('offset', (1,0))}\n"
                "The exact curve is enclosed. Integer lattice points still require the exact residual test."
            )
            if self.settings.axis == "offset":
                n = tile["n"]
                message += (f"\nExact plot origins for this slice: x={self.x_origins[n]}; "
                            f"|t|={self.t_origins[n]}.")
        else:
            indices = getattr(event, "ind", [])
            if not len(indices):
                return
            message = items[int(indices[0])].detail()
        print(message, flush=True)
        self.show_detail(message)

    def horizontal(self, x, n):
        if self.settings.axis == "ratio":
            return float(Fraction(x, 6*n+3))
        if self.settings.axis == "offset":
            return float(Fraction(x) - self.x_origins[n])
        return float(x)

    def _geometry_height(self, t, n):
        if self.settings.axis == "ratio":
            return float(Fraction(t, 6*n+3))
        if self.settings.axis == "offset":
            return float(Fraction(t) - self.t_origins[n])
        return float(t)

    def _depth(self, n):
        return self.sample_indices[n] if self.overview else n - self.settings.n

    def _slice_label(self, n):
        return f"sample {self.sample_indices[n]}" if self.overview else f"n={n}"

    def _prepare_coordinates(self):
        """Choose every large origin in exact arithmetic before float plotting."""
        s = self.settings
        self.sample_values = list(self.result.get("sample_n_values", range(s.n, s.n + s.slices)))
        self.sample_indices = {n: i for i, n in enumerate(self.sample_values)}
        windows = self.result.get("windows") or [
            {"n": n, "x_min": s.x_min, "x_max": s.x_max, "x_origin": s.x_min}
            for n in self.sample_values
        ]
        self.windows_by_n = {w["n"]: w for w in windows}
        self.x_origins = {n: self.windows_by_n[n]["x_origin"] for n in self.sample_values}
        self.per_slice_offsets = self.overview or getattr(s, "x_center_ratio", None) is not None
        tiles = self.result.get("tiles", [])
        first_tiles = {}
        first_records = {}
        for tile in tiles:
            first_tiles.setdefault(tile["n"], tile)
        for record in self.result["records"]:
            first_records.setdefault(record.n, record)
        if tiles:
            first = tiles[0]["t0"]
            self.t_origin = first.numerator // first.denominator
        elif self.result["records"]:
            self.t_origin = abs(self.result["records"][0].t) // 1
        else:
            self.t_origin = 0
        self.t_origins = {}
        for n in self.sample_values:
            origin = self.t_origin
            if self.per_slice_offsets:
                x = self.x_origins[n]
                s_n, numerator = coeffs(n)
                value = Fraction((s_n + x)**2) + Fraction(numerator, x) if x else None
                if value is not None and value >= 0:
                    origin = isqrt(value.numerator // value.denominator)
                elif n in first_tiles:
                    midpoint = first_tiles[n]["t0"]
                    origin = midpoint.numerator // midpoint.denominator
                elif n in first_records:
                    origin = abs(first_records[n].t) // 1
                else:
                    origin = 0
            self.t_origins[n] = origin

    def _display_records(self):
        all_records = self.result["records"]
        exact = [r for r in all_records if r.exact]
        trials = [r for r in all_records if not r.exact]
        if len(trials) > self.settings.max_display:
            stride = (len(trials) + self.settings.max_display - 1) // self.settings.max_display
            trials = trials[::stride]
        return trials + exact, len(trials)

    def _selected_slices(self):
        if self.overview:
            return self.sample_values[self.sample_cursor:self.sample_cursor + 2]
        available = sorted({r.n for r in self.result["records"]} |
                           {tile["n"] for tile in self.result.get("tiles", [])})
        if not available:
            return self.sample_values[:2]
        return available[:2]

    def _category(self, record):
        if not record.exact:
            return "trial"
        if record.primitive:
            return "primitive"
        if record.integral_lift:
            return "cubes"
        return "rational"

    def draw(self):
        from matplotlib.ticker import FuncFormatter, MaxNLocator, ScalarFormatter

        view = self.ax3.elev, self.ax3.azim
        self.ax2.clear()
        self.ax3.clear()
        self.ax3.view_init(*view)
        self.pick_data.clear()
        self._prepare_coordinates()
        self.selected_slices = self._selected_slices()
        s = self.settings
        modes = {"points": "Rational y values and trials",
                 "residual": "Exact residuals of retained trials",
                 "tiles": "Certified tangent tiles for the nonnegative |t| branch"}
        selected = ", ".join(map(str, self.selected_slices))
        self.headers[0].set_text(f"{modes[self.mode]}\nDisplayed slices: n = {selected}")
        window_text = (f"Sampled interval: n = {s.n}…{s.n_stop}" if self.overview else
                       f"Window: n = {s.n}…{s.n+s.slices-1}")
        self.headers[1].set_text(f"{modes[self.mode]}\n{window_text}")
        exact = _exact_records(self.result)
        records, n_trials_drawn = self._display_records()
        summary = (
            f"Engine: {s.engine} · target: {s.target} · exact points: {len(exact):,} · "
            f"integer cube lifts: {sum(r.integral_lift for r in exact):,} · "
            f"primitive: {sum(r.primitive for r in exact):,}\n"
            f"Drawing {n_trials_drawn:,} / {sum(not r.exact for r in self.result['records']):,} nonzero trials; "
            "all exact hits are drawn in 3D. Each ±y pair is counted once."
        )
        if self.overview:
            summary += f"\n{len(self.sample_values)} selected n values; other n values in the interval were not sampled."
        if s.engine == "lattice":
            summary += (f"\nCertified tiles: {len(self.result['tiles']):,} · "
                        f"enumeration/fallback nodes: {self.result['stats'].get('nodes',0):,}")
        if s.preset == "control":
            summary += "\nKnown nonprimitive control from a scaled cube-3 solution; not a discovery."
        elif self.per_slice_offsets and s.axis == "offset":
            summary += "\nPer-slice x and |t| origins are subtracted exactly before plotting; click for full values."
        elif self.overview or max(map(abs, self.sample_values)) > 2**53:
            summary += "\nNormalized/absolute curves can visually merge. Use --axis offset for local coordinate differences."
        if len(self.selected_slices) > 1:
            labels = [self._slice_label(n) for n in self.selected_slices]
            summary += (f"\n2D markers: {labels[0]} filled / dots; "
                        f"{labels[1]} outline / crosses.")
        for text in self.summaries:
            text.set_text(summary)
        order = self.view_order()
        next_mode = order[(order.index(self.mode)+1) % len(order)]
        next_label = {"points": "Show rational y", "residual": "Show residuals", "tiles": "Show tangent tiles"}[next_mode]
        for button in self.mode_buttons:
            button.label.set_text(next_label)
        offset_label = "Local x offset: x − x_origin(n)" if self.per_slice_offsets else f"x − ({s.x_min})"
        xlabel = {"ratio": "Normalized x / (6n + 3)", "x": "x", "offset": offset_label}[s.axis]
        for ax in (self.ax2, self.ax3):
            ax.set_xlabel(xlabel, labelpad=10)
            ax.xaxis.set_major_locator(MaxNLocator(6))
            ax.xaxis.set_major_formatter(ScalarFormatter(useOffset=True))
        if s.axis == "offset":
            self.ax3.set_xlabel("Local x offset", labelpad=10)
            self.ax3.xaxis.set_major_formatter(FuncFormatter(lambda value, pos: f"{value:.3g}"))
        self.ax2.grid(alpha=0.15)
        self.ax3.set_ylabel("Sample index" if self.overview else
                            f"Slice depth n − ({s.n})", labelpad=10)
        self.ax3.yaxis.set_major_locator(MaxNLocator(nbins=6, integer=True))
        if self.mode == "tiles":
            self.draw_tiles(records)
        else:
            self.draw_records(records)
        if self.mode == "residual" or (self.mode == "tiles" and s.axis == "offset"):
            # Inline scientific tick labels avoid 3D offset-text/axis-label collisions.
            self.ax3.zaxis.set_major_formatter(FuncFormatter(lambda value, pos: f"{value:.3g}"))
        # Retain the full requested n window, including slices with no survivors.
        if len(self.sample_values) > 1:
            self.ax3.set_ylim(-0.25, len(self.sample_values) - 1 + 0.25)
        else:
            self.ax3.set_ylim(-0.5, 0.5)
        for ax in (self.ax2, self.ax3):
            if ax.get_legend_handles_labels()[0]:
                ax.legend(loc="best" if ax is self.ax2 else "upper left", fontsize=8)
        if exact:
            self.show_detail(exact[0].detail())
        elif records:
            self.show_detail("No exact target hit in the selected n slices and x windows.\n" + records[0].detail())
        else:
            message = "No retained trial or exact hit in the selected n slices and x windows.\n"
            message += ("Certified tiles show the searched geometry; fallback portions are counted in Terminal."
                        if self.mode == "tiles" else
                        "Necessary filters can reject a small window completely. Change n/x ranges to explore.")
            self.show_detail(message)
        for fig in (self.fig2, self.fig3):
            fig.canvas.draw_idle()

    def _scatter_group(self, records, label, color, marker, size, alpha, height, signs=False):
        if not records:
            return
        data = [(r, sign) for r in records for sign in
                ((1, -1) if signs and r.y else (1,))]
        for index, n in enumerate(self.selected_slices):
            nearby = [(r, sign) for r, sign in data if r.n == n]
            if not nearby:
                continue
            shape = "x" if marker == "." and index else marker
            styling = ({"facecolors": "none", "edgecolors": color}
                       if index and marker != "." else {"c": color})
            artist = self.ax2.scatter(
                [self.horizontal(r.x, r.n) for r, sign in nearby],
                [height(r)*sign for r, sign in nearby],
                marker=shape, s=size, alpha=alpha, **styling,
                linewidths=0.5, picker=5 if size < 10 else 7,
                label=f"{self._slice_label(n)}; {label}" if len(self.selected_slices)>1 else label,
                zorder=2 if marker == "." else 5,
            )
            self.pick_data[artist] = ("record", [r for r, _ in nearby])
        artist = self.ax3.scatter(
            [self.horizontal(r.x, r.n) for r, sign in data],
            [self._depth(r.n) for r, sign in data],
            [height(r)*sign for r, sign in data],
            c=color, marker=marker, s=size, alpha=alpha, linewidths=0.5,
            depthshade=False, picker=5 if size < 10 else 7, label=label,
        )
        self.pick_data[artist] = ("record", [r for r, _ in data])

    def draw_records(self, records):
        import numpy as np

        if self.mode == "points":
            ylabel = "Rational y (gray trials need not satisfy the equation)"
            height = lambda r: float(r.y)
        else:
            kind = "r" if self.settings.target == "rational" else "t"
            ylabel = "E = r² − H" if kind == "r" else "R = x[t² − (S+x)²] − N"
            height = lambda r: float(r.residual)
            self.ax2.axhline(0, color="0.45", linewidth=0.8)
            if records and len(self.sample_values) > 1:
                xs = [self.horizontal(r.x, r.n) for r in records]
                lo, hi = min(xs), max(xs)
                if lo == hi:
                    lo, hi = lo-0.01, hi+0.01
                xx, nn = np.meshgrid([lo, hi], [0, len(self.sample_values)-1])
                self.ax3.plot_surface(xx, nn, np.zeros_like(xx), alpha=0.07, color="0.5", shade=False)
        self.ax2.set_ylabel(ylabel, labelpad=10)
        self.ax3.set_zlabel("Rational y" if self.mode == "points" else ylabel, labelpad=10)
        groups = [
            ("trial", "Nonzero-residual trials", "#7c8795", ".", 18, 0.65),
            ("rational", "Exact rational y; no integer cube lift", "#7b2cbf", "D", 52, 0.95),
            ("cubes", "Exact integer cube lift; nonprimitive", "#e07614", "o", 65, 0.95),
            ("primitive", "Primitive integer cube lift", "#238b45", "*", 150, 1.0),
        ]
        for category, label, color, marker, size, alpha in groups:
            subset = [r for r in records if self._category(r) == category]
            self._scatter_group(subset, label, color, marker, size, alpha, height,
                                signs=self.mode == "points")

    def draw_tiles(self, records):
        from matplotlib.colors import to_rgba
        from matplotlib.patches import Polygon
        from mpl_toolkits.mplot3d.art3d import Poly3DCollection

        ratio = self.settings.axis == "ratio"
        offset_label = "Local |t| offset: |t| − t_origin(n)" if self.per_slice_offsets else f"|t| − ({self.t_origin})"
        ylabel = ("Normalized |t| / (6n + 3)" if ratio else
                  offset_label if self.settings.axis == "offset" else
                  "|t| = |y(6n + 3 + x)|")
        self.ax2.set_ylabel(ylabel, labelpad=10)
        self.ax3.set_zlabel("Local |t| offset" if self.settings.axis == "offset" else ylabel, labelpad=10)
        tiles = self.result.get("tiles", [])
        # Share the drawing budget across slices so no sampled slice disappears.
        by_slice = {}
        for tile in tiles:
            by_slice.setdefault(tile["n"], []).append(tile)
        if len(tiles) <= 300:
            drawn_tiles = tiles
        else:
            quota = max(1, 300 // max(1, len(by_slice)))
            drawn_tiles = []
            for group in by_slice.values():
                count = min(quota, len(group))
                indices = ([0] if count == 1 else
                           [i*(len(group)-1)//(count-1) for i in range(count)])
                drawn_tiles.extend(group[i] for i in indices)
        labeled_slices = set()
        for tile in drawn_tiles:
            n, a, b = tile["n"], tile["a"], tile["b"]
            line = lambda x: tile["t0"] + tile["alpha"]*(x-tile["x0"])
            corners = [(a, line(a)-tile["w"]), (b, line(b)-tile["w"]),
                       (b, line(b)+tile["w"]), (a, line(a)+tile["w"])]
            vertices = [(self.horizontal(x,n), self._geometry_height(t,n)) for x,t in corners]
            color = f"C{self.sample_indices[n]%10}"
            if n in self.selected_slices:
                label = f"{self._slice_label(n)}; certified tiles" if n not in labeled_slices else None
                patch = Polygon(vertices, closed=True, facecolor=to_rgba(color, 0.10),
                                edgecolor=to_rgba(color, 0.80), linewidth=0.9, picker=True,
                                label=label)
                labeled_slices.add(n)
                self.ax2.add_patch(patch)
                self.pick_data[patch] = ("tile", tile)
                self.ax2.update_datalim(vertices)
            vertices3 = [(x,self._depth(n),t) for x,t in vertices]
            patch3 = Poly3DCollection([vertices3], facecolors=to_rgba(color, 0.08),
                                     edgecolors=to_rgba(color, 0.65), linewidths=0.8, picker=True)
            self.ax3.add_collection3d(patch3)
            self.pick_data[patch3] = ("tile", tile)
        self.ax2.autoscale_view()
        if tiles:
            corners3 = []
            for tile in tiles:
                for x in (tile["a"], tile["b"]):
                    center = tile["t0"]+tile["alpha"]*(x-tile["x0"])
                    for sign in (-1,1):
                        corners3.append((self.horizontal(x,tile["n"]),
                                         self._depth(tile["n"]),
                                         self._geometry_height(center+sign*tile["w"], tile["n"])))
            self.ax3.auto_scale_xyz([p[0] for p in corners3], [p[1] for p in corners3], [p[2] for p in corners3])
        groups = [
            ("trial", "Integer lattice / fallback trials", "#7b8490", ".", 20, 0.65),
            ("cubes", "Exact integer cube lift; nonprimitive", "#e07614", "o", 65, 0.95),
            ("primitive", "Primitive integer cube lift", "#238b45", "*", 150, 1.0),
        ]
        for category, label, color, marker, size, alpha in groups:
            subset = [r for r in records if self._category(r) == category]
            self._scatter_group(subset, label, color, marker, size, alpha,
                                lambda r: self._geometry_height(r.aux, r.n))
        if len(drawn_tiles) < len(tiles):
            self.ax2.text(0.02,0.02,
                          f"Drawing {len(drawn_tiles)} / {len(tiles)} tile outlines across all slices; every tile was searched.",
                          transform=self.ax2.transAxes, va="bottom", fontsize=7.5)

    def save(self, prefix):
        prefix = Path(prefix)
        prefix.parent.mkdir(parents=True, exist_ok=True)
        paths = [prefix.with_name(prefix.name+"-"+kind+".png") for kind in ("2d", "3d")]
        for figure, path in zip((self.fig2,self.fig3),paths):
            figure.savefig(path, dpi=150)
        return paths



def _parse_exact_ratio(value):
    try:
        return Fraction(value)
    except (ValueError, ZeroDivisionError) as exc:
        raise argparse.ArgumentTypeError("Use a finite exact ratio such as 1/10 or -3/2") from exc


def parse_lab_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Exact rational-y search and certified lattice visualization, including sampled n=10^15..10^16 windows.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  python3 rational_y_lab.py --preset large
  python3 rational_y_lab.py --preset large --slices 24 --mode residual
  python3 rational_y_lab.py --preset local-large --n 5000000000000000
  python3 rational_y_lab.py --preset large --engine scan --target rational --mode residual
  python3 rational_y_lab.py --preset large --search-only --csv large-results.csv
  python3 rational_y_lab.py --preset demo
  python3 rational_y_lab.py --preset control

--n-stop makes --slices an EXACT INTEGER sample count across an inclusive
interval, not an exhaustive sweep. Cube targets select nearby admissible
n=2 or5 mod9. Rational mode retains unrestricted n samples.
Without --n-stop, --slices means consecutive n values.

Large presets use a separate x window in each slice, centred at
floor((6n+3)*x-center-ratio), with every integer x in centre +/- half-width
covered by the chosen engine. Offset axes subtract each slice's exact origin
before float conversion. The large presets do not bound all cube coordinates.
""")
    parser.add_argument("--preset", choices=("demo", "large", "local-large", "control"),
                        default="demo", help="large samples 10^15..10^16; local-large inspects consecutive large n")
    parser.add_argument("--engine", choices=("scan", "lattice"))
    parser.add_argument("--target", choices=("rational", "cubes", "primitive"),
                        help="Large lattice presets default to primitive; scan defaults to rational")
    parser.add_argument("--n", "--n-start", dest="n", type=int,
                        help="First integer n, or start of sampled interval")
    parser.add_argument("--n-stop", type=int,
                        help="Inclusive endpoint of sampled n interval; does not request an exhaustive sweep")
    parser.add_argument("--slices", type=int,
                        help="Number of sampled n values with n-stop, otherwise consecutive slices; 1..100")
    parser.add_argument("--x-min", type=int)
    parser.add_argument("--x-max", type=int)
    parser.add_argument("--x-center-ratio", type=_parse_exact_ratio,
                        help="Exact per-n centre ratio x/(6n+3), e.g. 1/10; replaces fixed x bounds")
    parser.add_argument("--x-half-width", type=int,
                        help="Integer half-width around each per-n x centre (large lattice default 5000000)")
    parser.add_argument("--mode", choices=("points", "residual", "tiles"))
    parser.add_argument("--axis", choices=("ratio", "x", "offset"),
                        help="offset subtracts exact per-slice origins before plotting")
    parser.add_argument("--tile-width", type=int,
                        help="Initial integer-x tile width; large default 1000000, other presets 64")
    parser.add_argument("--max-nodes", type=int, default=200000,
                        help="Global lattice enumeration/fallback work budget")
    parser.add_argument("--max-pairs", type=int, default=300000,
                        help="Global exact-scan integer-pair budget")
    parser.add_argument("--max-display", type=int, default=10000,
                        help="Maximum nonzero trials drawn; all exact hits remain")
    parser.add_argument("--csv", type=Path,
                        help="Export exact trial/hit records plus a companion -windows.csv coverage file")
    parser.add_argument("--search-only", action="store_true",
                        help="Exact search without importing Matplotlib")
    parser.add_argument("--save-prefix", type=Path,
                        help="Export PREFIX-2d.png and PREFIX-3d.png without windows")
    args = parser.parse_args(argv)
    large = args.preset in ("large", "local-large")
    fixed_requested = args.x_min is not None or args.x_max is not None
    ratio_requested = args.x_center_ratio is not None or args.x_half_width is not None
    if fixed_requested and (args.x_min is None or args.x_max is None):
        parser.error("Supply both --x-min and --x-max for a fixed x window")
    if fixed_requested and ratio_requested:
        parser.error("Choose fixed --x-min/--x-max OR --x-center-ratio/--x-half-width")
    defaults = dict(n=2, n_stop=None, slices=12, x_min=-100, x_max=100,
                    engine="scan", mode="points", axis="ratio", tile_width=64,
                    x_center_ratio=None, x_half_width=5000)
    if large:
        defaults.update(n=10**15 if args.preset == "large" else 10**15+1,
                        n_stop=10**16 if args.preset == "large" else None,
                        engine="lattice", mode="tiles", axis="offset",
                        tile_width=1000000, x_center_ratio=Fraction(1, 10),
                        x_half_width=5000000)
        # A direct scan needs a smaller initial x window than the lattice engine.
        if args.engine == "scan":
            defaults.update(mode="points", x_half_width=5000)
    elif args.preset == "control":
        center = -1423660264321272634220
        defaults.update(n=-393929487545366518, slices=1,
                        x_min=center-128, x_max=center+128,
                        engine="lattice", mode="tiles", axis="offset")
    for name, default in defaults.items():
        if getattr(args, name) is None:
            setattr(args, name, default)
    if fixed_requested:
        args.x_center_ratio = None
    elif ratio_requested and args.x_center_ratio is None:
        parser.error("--x-half-width needs --x-center-ratio outside a large preset")
    target = args.target or ("rational" if args.engine == "scan" else
                             "primitive" if large else "cubes")
    if not 1 <= args.slices <= 100:
        parser.error("--slices must be between 1 and 100")
    if args.n_stop is not None:
        if args.n_stop < args.n:
            parser.error("Require --n-stop >= --n")
        if args.n_stop > args.n and args.slices < 2:
            parser.error("A sampled interval needs at least two --slices")
    if args.x_min > args.x_max:
        parser.error("Require x-min <= x-max")
    if args.x_half_width < 0:
        parser.error("--x-half-width must be nonnegative")
    if min(args.tile_width, args.max_nodes, args.max_pairs, args.max_display) <= 0:
        parser.error("Tile width and all budgets must be positive")
    if args.engine == "lattice" and target == "rational":
        parser.error("Use --engine scan for all rational y; lattice targets cubes or primitive")
    if args.mode == "tiles" and args.engine != "lattice":
        parser.error("--mode tiles requires --engine lattice")
    if args.search_only and args.save_prefix:
        parser.error("Choose either --search-only or --save-prefix")
    settings = LabSettings(
        preset=args.preset, n=args.n, n_stop=args.n_stop, slices=args.slices,
        x_min=args.x_min, x_max=args.x_max,
        x_center_ratio=args.x_center_ratio, x_half_width=args.x_half_width,
        engine=args.engine, target=target, axis=args.axis,
        tile_width=args.tile_width, max_nodes=args.max_nodes,
        max_pairs=args.max_pairs, max_display=args.max_display,
    )
    return args, settings


def main(argv=None):
    args, settings = parse_lab_args(argv)
    print("Searching the selected finite n/x windows ...", flush=True)
    try:
        result = run_search(settings)
    except (ValueError, WorkLimitError) as exc:
        print(f"Search NOT completed: {exc}", file=sys.stderr)
        return 2
    print_run_summary(result, settings)
    if args.csv:
        export_csv(args.csv, result["records"])
        manifest_path = export_window_manifest(args.csv, result, settings)
        print(f"Saved exact records to {args.csv}")
        print(f"Saved exact searched n/x windows to {manifest_path}")
    if args.search_only:
        return 0
    if args.save_prefix:
        import matplotlib
        matplotlib.use("Agg")
    try:
        explorer = RationalYExplorer(settings, result, mode=args.mode)
    except (ValueError, OverflowError) as exc:
        print(f"The exact search completed, but plotting failed: {exc}\n"
              "Use --search-only --csv OUTPUT.csv, or --axis offset for large coordinates.",
              file=sys.stderr)
        return 2
    if args.save_prefix:
        for path in explorer.save(args.save_prefix):
            print(f"Saved {path}")
        explorer.plt.close("all")
    else:
        print("Click points or tiles for exact values; drag the 3D view to rotate.")
        print("Left/Right or buttons select samples in an overview, or shift n in a local window.")
        explorer.plt.show()
    return 0


