    x_half_width: int = 5000


def selected_n_values(settings):
    """Choose exact integer slices, never a floating-point interpolation.

    A bounded overview samples its n interval; it does not exhaust it.
    Integer-cube targets snap each anchor to the nearest admissible residue
    within the requested interval. Ties prefer the smaller n. Rational-only
    searches must not apply this integer-lift restriction.
    """
    s = settings
    if s.target not in ("rational", "cubes", "primitive"):
        raise ValueError("target must be rational, cubes, or primitive")
    if s.slices < 1:
        raise ValueError("--slices must be positive")
    if s.n_stop is None:
        return list(range(s.n, s.n + s.slices))
    if s.n_stop < s.n:
        raise ValueError("Require n <= n-stop")
    if s.n_stop > s.n and s.slices < 2:
        raise ValueError("A sampled n range requires at least two slices")
    if s.n_stop == s.n:
        anchors = [s.n]
    else:
        anchors = [s.n + i * (s.n_stop - s.n) // (s.slices - 1)
                   for i in range(s.slices)]
    if s.target == "rational":
        return sorted(set(anchors))
    chosen = []
    for anchor in anchors:
        base = anchor - anchor % 9
        candidates = [base + residue + shift
                      for residue in (2, 5) for shift in (-9, 0, 9)
                      if s.n <= base + residue + shift <= s.n_stop]
        if not candidates:
            raise ValueError(
                "The requested n interval contains no n congruent to 2 or 5 modulo 9; "
                "no integer-cube slice is admissible. Widen the interval or use "
                "--engine scan --target rational to examine all rational points."
            )
        chosen.append(min(candidates, key=lambda value: (abs(value - anchor), value)))
    return sorted(set(chosen))


def sample_window_specs(settings):
    """Exact per-slice windows, including the origin used for offset plots."""
    s = settings
    if s.x_center_ratio is None and s.x_min > s.x_max:
        raise ValueError("Require x-min <= x-max")
    if s.x_center_ratio is not None and s.x_half_width < 0:
        raise ValueError("--x-half-width must be nonnegative")
    windows = []
    for n in selected_n_values(s):
        if s.x_center_ratio is None:
            lo, hi, origin = s.x_min, s.x_max, s.x_min
        else:
            center = Fraction(s.x_center_ratio) * (6 * n + 3)
            origin = center.numerator // center.denominator
            lo, hi = origin - s.x_half_width, origin + s.x_half_width
        windows.append({
            "n": n, "x_min": lo, "x_max": hi, "x_origin": origin,
            "sieve_rejected": s.target != "rational" and n % 9 not in (2, 5),
        })
    return windows


def run_search(settings):
    """Complete the selected finite windows, or raise without partial success.

    With n_stop set, completeness applies only to the reported sampled n
    values and their integer x windows, not to every n between the bounds.
    """
    s = settings
    if s.engine not in ("scan", "lattice"):
        raise ValueError("engine must be scan or lattice")
    if s.engine == "lattice" and s.target == "rational":
        raise ValueError("The lattice engine searches integer cube lifts. Choose --target cubes or primitive.")
    if s.max_pairs < 1 or s.max_nodes < 1 or s.tile_width < 1:
        raise ValueError("Search budgets and tile width must be positive")
    windows = sample_window_specs(s)
    pair_count = sum(w["x_max"] - w["x_min"] + 1 for w in windows)
    if s.engine == "scan" and pair_count > s.max_pairs:
        raise ValueError(
            f"These {len(windows):,} selected n slices contain {pair_count:,} integer pairs; "
            f"the scan limit is {s.max_pairs:,}. Reduce --x-half-width or --slices, "
            "or increase --max-pairs."
        )
    remaining = s.max_nodes
    records, tiles, fallback = [], [], []
    stats = {
        "target": s.target, "complete": False,
        "scope": "selected_n_windows" if s.n_stop is not None else "consecutive_n_windows",
        "window_pairs": pair_count, "requested_slices": s.slices,
        "selected_slices": len(windows), "n_sieve_rejected": 0,
        "candidate_sieve_rejected": 0, "nonprimitive_rejected": 0,
    }
    seen = set()

    def accumulate(part_stats):
        for key, value in part_stats.items():
            if isinstance(value, int) and not isinstance(value, bool):
                stats[key] = stats.get(key, 0) + value

    for window in windows:
        n, lo, hi = window["n"], window["x_min"], window["x_max"]
        if window["sieve_rejected"]:
            stats["n_sieve_rejected"] += 1
        if s.engine == "scan":
            # The total budget was checked above, across all per-n windows.
            part = scan_window(n, 1, lo, hi, target=s.target, max_pairs=s.max_pairs)
            accumulate(part["stats"])
            records.extend(part["records"])
            continue
        if window["sieve_rejected"]:
            continue
        if remaining <= 0:
            raise WorkLimitError(
                "Global lattice node budget exhausted; increase --max-nodes "
                "or narrow the selected windows."
            )
        part = lattice_slice(n, lo, hi, tile_width=s.tile_width, max_nodes=remaining)
        remaining -= part["stats"]["nodes"]
        accumulate(part["stats"])
        tiles.extend(part["tiles"])
        fallback.extend((n, x, t) for x, t in part.get("fallback_points", []))
        for x, t in part["points"]:
            if not cheap_lift_allowed(n, x, primitive=s.target == "primitive"):
                stats["candidate_sieve_rejected"] += 1
                continue
            key = n, x, t
            if key in seen:
                continue
            seen.add(key)
            rec = make_t_record(n, x, t)
            if rec.exact and s.target == "primitive" and not rec.primitive:
                stats["nonprimitive_rejected"] += 1
                continue
            records.append(rec)
    records.sort(key=lambda r: (r.n, r.x, r.y))
    exact = [r for r in records if r.exact]
    stats.update(
        complete=True, records=len(records), exact_hits=len(exact),
        rational_only_hits=sum(not r.integral_lift for r in exact),
        integral_hits=sum(r.integral_lift for r in exact),
        primitive_hits=sum(r.primitive for r in exact),
    )
    return {
        "records": records, "tiles": tiles, "stats": stats,
        "fallback_points": fallback, "sample_n_values": [w["n"] for w in windows],
        "windows": windows, "sampled_overview": s.n_stop is not None,
    }




