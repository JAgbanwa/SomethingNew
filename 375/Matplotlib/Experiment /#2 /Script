def export_window_manifest(records_path, result, settings):
    """Keep exact search coverage even when the candidate CSV has no rows."""
    path = Path(records_path)
    coverage_path = path.with_name(path.stem + "-windows.csv")
    coverage_path.parent.mkdir(parents=True, exist_ok=True)
    columns = ["sample_index", "n", "x_min", "x_max", "x_origin",
               "n_sieve_rejected", "engine", "target", "sampled_overview",
               "requested_n_start", "requested_n_stop", "complete_for_this_window"]
    with coverage_path.open("w", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(columns)
        for index, window in enumerate(result["windows"]):
            writer.writerow([
                index, window["n"], window["x_min"], window["x_max"], window["x_origin"],
                window["sieve_rejected"], settings.engine, settings.target,
                result["sampled_overview"], settings.n,
                settings.n_stop if settings.n_stop is not None else settings.n + settings.slices - 1,
